# Project-root .env - read by Docker Compose to fill ${...} in the YAML.
DB_NAME=drive_db
DB_USER=drive_user
DB_PASSWORD=change_me

# Host directory holding the file blobs. The container always sees it at
# /data/storage regardless of what this says.
STORAGE_HOST_PATH=/mnt/external-ssd/drive-storage

# Must own STORAGE_HOST_PATH. Check with `id -u` and `id -g` on that machine -
# the server's user is not guaranteed to be 1000.
APP_UID=1000
APP_GID=1000

# Where the API is published on the host.
API_PORT=8008

# Comma-separated origins the frontend is served from.
# dev    | http://localhost:5173
# server | http://10.0.0.50:5173

CORS_ORIGINS=http://localhost:5173


# Production ENV storage root, but other above details are only for db container.